# Copie para /opt/academy/academy.env na VPS. Somente valores NÃO secretos.
# Senhas e chaves vão em Docker secrets (veja docs/04-infraestrutura.md §4.5).
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_FROM_ADDRESS=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencryptresolver
VIDEO_WORKER_CPUS=2.0
